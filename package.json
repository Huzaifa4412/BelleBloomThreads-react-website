{
  "name": "belle-bloom-threads",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "BelleBloomThreads crochet pattern storefront — React, Tailwind CSS and Motion.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "start": "vite --host 127.0.0.1 --port 4173",
    "studio": "npm --prefix studio run dev",
    "build": "vite build && node scripts/prerender-blog.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "node --test scripts/collection.test.mjs",
    "lint": "eslint src scripts vite.config.js",
    "check": "node scripts/validate-catalog.mjs && npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
